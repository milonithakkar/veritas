# Copy this file to .env and fill in your values
# Never commit .env to GitHub

# OpenAI / Gemini API key (used by the AsyncOpenAI client)
OPENAI_API_KEY=your_openai_api_key_here

# Google/Vertex AI API key (if you use Google generative endpoints)
GOOGLE_API_KEY=your_google_api_key_here

# Primary models
PRIMARY_MODEL=gemini-1.5-flash
JUDGE_MODEL=gemini-1.5-flash

# ChromaDB persistence directory
CHROMA_DB_PATH=./chroma_db

# SQLite audit trail path
AUDIT_DB_PATH=./audit.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Frontend: URL of running backend (used by Next.js client-side fetches)
# Example: NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
